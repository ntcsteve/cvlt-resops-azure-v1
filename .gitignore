# secrets
.env
# live tenant ids — fill config/workshop.yaml locally from the .example
config/workshop.yaml
*.tfvars
!*.tfvars.example

# terraform
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# python
.venv/
__pycache__/
*.pyc

# evidence (regenerated each run)
evidence/

# operator working files (hold live, environment-specific ids)
resops/operator/drills/restore_headless.json
resops/operator/drills/restore_headless.json.*

# terraform saved plans
tfplan
*.tfplan

# private working journal — keep local, not for the public repo
NOTES.md

# cold-start briefing — names live subscription/tenant ids, same secrecy as
# HANDOVER. This is the file a fresh session reads FIRST.
START-HERE.md

# session handover/log — accumulate live tenant/subscription ids each session
HANDOVER.md
# rotated by /wrap-up — same live ids, same secrecy. NOTE: gitignore has
# no trailing comments; a pattern with one on the same line matches NOTHING.
# FIELD-NOTES.md was HANDOVER.prev.md until 2026-08-13. Holds live ids.
FIELD-NOTES.md
LOG.md

# python packaging build artifacts
*.egg-info/
build/
dist/

# observability stack state (cattle — deploy before a workshop, destroy after)
infra/observability/.terraform/
infra/observability/*.tfstate*

# facilitator runbook — carries delivery coaching, the "what you must not
# claim" list, and tenant-specific investigation detail. Useful to whoever
# delivers the day, not something to publish under a vendor-positioned
# workshop. Shared directly with facilitators, like HANDOVER and NOTES.
FACILITATOR.md

# macOS finder droppings
.DS_Store
