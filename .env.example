# Copy to .env and fill in. .env is gitignored — secrets never get committed.
# Production: replace with your secret manager / OIDC; see resops/client.py.

# Access token + refresh token from Command Center (avatar > Access Tokens > Add).
# Used by: resops (read-only ladder + gate) and op (write lane).
# Prefer a long-lived service-account token for CI — user tokens expire between runs.
CV_ACCESS_TOKEN=
CV_REFRESH_TOKEN=

# Terraform provider token — only needed if you run infra/platform/ to create
# CV plans as code. Separate from the API tokens above: get it from
# Command Center > Manage > Security > API tokens (a long-lived token with
# plan-management scope). If you create plans manually in the console, leave blank.
CV_TER_TOKEN=
