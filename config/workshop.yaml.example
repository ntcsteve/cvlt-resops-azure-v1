# config/workshop.yaml — the ONE file you fill for the workshop.
# Copy to config/workshop.yaml (gitignored) and fill it in.
# Terraform, resops, and op all read this file. Secrets (tokens) live in .env, never here.
#
# BEFORE YOU FILL THIS IN:
#   1. Run the Metallic wizard: Protect > Virtual Machines > Add Hypervisor > Microsoft Azure
#      It creates the service principal and hypervisor — most IDs below don't exist until then.
#   2. Assign roles to the SP (requires Owner on the subscription — Contributor is not enough):
#        az role assignment create --assignee <sp-object-id> --role "Contributor" \
#          --scope /subscriptions/<subscription-id>
#        az role assignment create --assignee <sp-object-id> --role "Storage Blob Data Contributor" \
#          --scope /subscriptions/<subscription-id>
#   3. Verify the token works: `resops list` — should return your VM groups, not a 403.

# ── Your workload — change this per run ──────────────────────────────
workload:
  name: payments-api            # codename — flows to the VM name, CV group (resops-<name>-vg), and tags
  tier: tier2                   # tier1 (RPO 8h / RTO 4h) or tier2 (RPO 24h / RTO 8h) — see config/tiers.yaml
  env: prod                     # prod / staging / dev — tag on all Azure resources
  owner: platform-team          # owning team — for portal filtering and cost attribution
  vm_size: Standard_F1als_v7    # optional — cheapest in eastus2 (1 vCPU / 2 GB)
  location: eastus2             # optional
  # vm_group_id: 12345          # optional — only needed to gate a group with a non-standard name

# ── Your platform — set once ─────────────────────────────────────────
platform:
  # Your Metallic tenant URL + /commandcenter/api. No trailing slash.
  # Wrong URL gives a 403 or non-JSON error on `resops list` — fix this first.
  #
  # GOTCHA: Error 72:106 ("Access forbidden to fetch discovery criteria") has TWO causes:
  #   1. SP has no IAM roles → assign Contributor + Storage Blob Data Contributor (see above)
  #   2. Wrong tenant in the Metallic credential → the Application ID + Tenant ID in
  #      Protect > Hypervisors > Edit must match the tenant where your subscription lives.
  #      Confirm: az account show --query tenantId -o tsv — must match the credential's Tenant ID.
  #   Fix 1 first. If 72:106 persists after roles are assigned, it's cause 2.
  web_service_url: https://<tenant>.metallic.io/commandcenter/api

  # az account show --query id -o tsv
  # Run `az account show` first to confirm you're on the right subscription.
  subscription_id: <azure-subscription-guid>

  # The SP Object ID from Entra ID — NOT the Application (client) ID, they are different GUIDs.
  # After the wizard runs: az ad sp show --id <appId> --query id -o tsv
  #
  # GOTCHA: Metallic creates its OWN app registration during the wizard — check which
  # Application ID it actually saved in Protect > Hypervisors > Edit, then get the
  # Object ID for THAT app. Don't assume it's the one you created manually.
  #
  # GOTCHA: You need Owner (not Contributor) to assign the roles above.
  # Contributor can create resources but cannot touch IAM. If you only have Contributor,
  # ask your Azure admin to grant you User Access Administrator, or run the assignments for you.
  commvault_sp_object_id: <service-principal-object-id>

  hypervisor:
    # Protect > Hypervisors > click your hypervisor > integer in the URL
    id: <hypervisor-client-id>
    # Display name on the same page
    name: <hypervisor-name>
    # Protect > Hypervisors > Properties tab — different integer from `id` above
    instance_id: <instance-id>

  # Protect > Plans > click your plan > integer in the URL
  # Or after running infra/platform/: terraform -chdir=infra/platform output plan_ids
  #   → {"tier1": 42, "tier2": 99} — use the id for your workload's tier
  plan_id: <plan-id>

  # Manage > Storage > Libraries > pool display name (a string, not an ID)
  storage_pool_name: <managed-storage-pool-name>

# ── Gate policy — optional; defaults apply if omitted ────────────────
gate:
  frameworks: [dora, nist-800-53, apra-cps230]   # compliance crosswalk packs
  recovery_proof_max_age_days: 7                  # proof older than this HOLDs the gate
  # rpo_target_hours: 6        # optional — tighter than the tier's default
  # rto_target_minutes: 60     # optional — tighter than the tier's default
